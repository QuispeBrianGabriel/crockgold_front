# Copiar a .env junto a compose.yml (ignorado por git): cp docker/.env.example docker/.env

# Puerto del host donde se publica `ng serve` (siempre en 127.0.0.1)
WEB_PORT=4200

# URL base de la API (crockgold_core); el front llama a $API_URL/auth/login, etc.
# Vacía = mismo origen que el front. Tras cambiarla hay que recrear el contenedor.
API_URL=http://localhost:8080
